# Prince of Tides: environment variables. Copy to .env.local for local development.
# Nothing here is required for phase 1 to run locally: without email settings, booking emails are
# printed to the server console instead of sent. See docs/booking-architecture.md.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute site URL, used in email links and Stripe return URLs. TODO_OWNER: your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase 1: request to book (siteConfig.features.emailNotifications)
# ---------------------------------------------------------------------------
# Emails send only when all three are set; otherwise they are logged to the console.
RESEND_API_KEY=
# Verified Resend sender, e.g. "Prince of Tides <bookings@yourdomain.com>". BOOKING_FROM_EMAIL is
# accepted as an older alias.
EMAIL_FROM=
# Host inbox that receives new requests (guest replies go to the guest via reply-to).
BOOKING_NOTIFY_EMAIL=

# Booking store adapter: file (default locally, writes data/bookings.json), memory (default on
# Vercel; the host email and the runtime log are the record), postgres (not implemented yet; add the
# adapter in src/lib/booking/store.ts before phase 1b). Vercel's filesystem is ephemeral: do not rely
# on "file" in production.
BOOKING_STORE=
# Directory for the file store (default ./data).
BOOKING_DATA_DIR=
# Database for phase 1b and later (Neon or Supabase Postgres).
DATABASE_URL=

# Max booking requests per IP per hour (default 5).
BOOKING_RATE_LIMIT_MAX=

# Manual blocks file (default src/lib/booking/blocked-dates.json). Mainly for tests.
BLOCKED_DATES_FILE=

# ---------------------------------------------------------------------------
# Phase 2: iCal availability sync (siteConfig.features.icalSync must also be true)
# ---------------------------------------------------------------------------
# Export URLs from each platform's calendar settings.
AIRBNB_ICAL_URL=
VRBO_ICAL_URL=
# Long random token protecting /api/calendar.ics?token=... (required in production for the export).
ICAL_EXPORT_TOKEN=
# Optional, protects cron routes when added.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Phase 3: Stripe Checkout (siteConfig.features.stripeCheckout must also be true;
# /api/checkout and /api/stripe/webhook return 404 otherwise)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only if embedded Checkout is added later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Interim admin API auth (admin routes not built yet).
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Tests (Playwright)
# ---------------------------------------------------------------------------
# Server to test against (default http://localhost:3100; started with a production build if absent).
PW_BASE_URL=
# Chromium executable override (default: newest chromium-* under PLAYWRIGHT_BROWSERS_PATH).
PW_CHROMIUM=
